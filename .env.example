# Optional. Set environment variables in the shell; this file is not loaded automatically.
OPENAI_API_KEY=
# Choose an available model that supports Responses API + Structured Outputs.
OPENAI_MODEL=
# local uses a running llama.cpp instance; no API key is required.
# LLM_PROVIDER=local
# LOCAL_LLM_URL=http://127.0.0.1:8089
# LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct
# Optional alternative to Windows DPAPI storage. Never commit a real token.
TELEGRAM_BOT_TOKEN=
